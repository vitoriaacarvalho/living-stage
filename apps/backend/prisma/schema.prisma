generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id
  name           String
  email          String
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  accounts       Account[]
  schoolsCreated School[]  @relation("SchoolCreator")
  schools        School[]  @relation("SchoolTeachers")
  invitesCreated Invite[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model School {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("SchoolCreator", fields: [createdById], references: [id])
  teachers    User[]   @relation("SchoolTeachers")
  invite      Invite?
  dancers     Dancer[]
  dances      Dance[]
  shows       Show[]

  @@map("school")
}

model Invite {
  id          String   @id @default(cuid())
  schoolId    String   @unique
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code        String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("invite")
}

model Dancer {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  color     Int?
  createdAt DateTime     @default(now())
  castings  CastMember[]

  @@index([schoolId])
  @@map("dancer")
}

model Dance {
  id         String       @id @default(cuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title      String
  showGuides Boolean      @default(true)
  labelMode  LabelMode    @default(name)
  colorMode  ColorMode    @default(dancer)
  durationMs Int?
  createdAt  DateTime     @default(now())
  cast       CastMember[]
  figures    Figure[]
  showItems  ActItem[]

  @@index([schoolId])
  @@map("dance")
}

enum LabelMode {
  name
  role
  both

  @@map("label_mode")
}

enum ColorMode {
  dancer
  role

  @@map("color_mode")
}

model CastMember {
  id        String     @id @default(cuid())
  danceId   String
  dance     Dance      @relation(fields: [danceId], references: [id], onDelete: Cascade)
  dancerId  String?
  dancer    Dancer?    @relation(fields: [dancerId], references: [id], onDelete: SetNull)
  role      String?
  createdAt DateTime   @default(now())
  positions Position[]
  paths     Path[]

  @@unique([danceId, dancerId])
  @@map("cast_member")
}

model Figure {
  id           String     @id @default(cuid())
  danceId      String
  dance        Dance      @relation(fields: [danceId], references: [id], onDelete: Cascade)
  order        Int
  name         String?
  transitionMs Int        @default(4000)
  positions    Position[]
  paths        Path[]

  @@unique([danceId, order])
  @@map("figure")
}

model Position {
  figureId     String
  figure       Figure     @relation(fields: [figureId], references: [id], onDelete: Cascade)
  castMemberId String
  castMember   CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)
  x            Float
  y            Float

  @@id([figureId, castMemberId])
  @@map("position")
}

// The route a cast member takes into a figure; points are { along, side } relative to
// the straight line from her spot in the figure before (see PathPoint in shared).
model Path {
  figureId     String
  figure       Figure     @relation(fields: [figureId], references: [id], onDelete: Cascade)
  castMemberId String
  castMember   CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)
  points       Json

  @@id([figureId, castMemberId])
  @@map("path")
}

model Show {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title      String
  date       DateTime  @db.Date
  time       String?
  venue      String?
  intervalMs Int       @default(0)
  createdAt  DateTime  @default(now())
  acts       Act[]
  items      ActItem[]

  @@index([schoolId])
  @@map("show")
}

model Act {
  id     String    @id @default(cuid())
  showId String
  show   Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  order  Int
  name   String?
  items  ActItem[]

  @@unique([showId, order])
  @@map("act")
}

// showId repeats the act's show so the database can refuse a dance twice in one show.
model ActItem {
  id      String @id @default(cuid())
  showId  String
  show    Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  actId   String
  act     Act    @relation(fields: [actId], references: [id], onDelete: Cascade)
  danceId String
  dance   Dance  @relation(fields: [danceId], references: [id], onDelete: Cascade)
  order   Int

  @@unique([actId, order])
  @@unique([showId, danceId])
  @@map("act_item")
}
