{
  "name": "living-stage",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "living-stage",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@living-stage/backend",
      "version": "0.0.0",
      "extraneous": true,
      "dependencies": {
        "@living-stage/shared": "*"
      }
    },
    "apps/backend": {
      "name": "@living-stage/backend",
      "version": "0.0.0",
      "dependencies": {
        "@living-stage/shared": "*"
      }
    },
    "apps/frontend": {
      "name": "@living-stage/frontend",
      "version": "0.0.0",
      "dependencies": {
        "@living-stage/shared": "*"
      }
    },
    "apps/web": {
      "name": "@living-stage/frontend",
      "version": "0.0.0",
      "extraneous": true,
      "dependencies": {
        "@living-stage/shared": "*"
      }
    },
    "node_modules/@living-stage/backend": {
      "resolved": "apps/backend",
      "link": true
    },
    "node_modules/@living-stage/frontend": {
      "resolved": "apps/frontend",
      "link": true
    },
    "node_modules/@living-stage/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@living-stage/shared",
      "version": "0.0.0"
    }
  }
}
